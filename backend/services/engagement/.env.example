# Port this service listens on (internal network only; the BFFs are the public edge).
PORT=4030
# MongoDB server (base URI, no database name needed). The service always uses its OWN database, DB_NAME below.
# Local:  mongodb://127.0.0.1:27017        Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
# Database owned by this service.
DB_NAME=engagement
# HS256 secret shared by every service and BFF (>= 16 chars). Requests without a valid token are refused with 401.
INTERNAL_JWT_SECRET=
# Callers allowed to talk to this service (JWT `iss`), comma-separated.
ALLOWED_ISSUERS=mobile-bff,admin-bff,monolith,catalog,wallet,orders,calls,identity
# Expo push endpoint used by announcement push.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Identity service (optional): asked how many active operators may approve, so a risky version change goes to a SECOND operator. Unset = one-operator stack (the requester self-approves, audited).
IDENTITY_URL=
# Per-call timeout for the identity call, milliseconds.
SERVICE_TIMEOUT_MS=5000
# How often (ms, 0 = off) pending approval requests older than 24 h are marked expired.
APPROVAL_SWEEP_EVERY_MS=60000
# production | (unset)
NODE_ENV=
# Reported by /health so a deploy can tell the new build from the old.
RENDER_GIT_COMMIT=
GIT_COMMIT=
