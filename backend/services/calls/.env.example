# Port this service listens on (internal network only; the BFFs are the public edge).
PORT=4080
# MongoDB server (base URI, no database name needed). The service always uses its OWN database, DB_NAME below.
# Local:  mongodb://127.0.0.1:27017        Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
# Database owned by this service (collections: astrologers, callsessions, astrologerearnings, payouts, callintents).
# Run `node tools/split-db.mjs --service calls` BEFORE its first start on real data.
DB_NAME=calls
# HS256 secret shared by every service and BFF (>= 16 chars). Requests without a valid token are refused with 401.
INTERNAL_JWT_SECRET=
# Callers allowed to talk to this service (JWT `iss`), comma-separated. Each route family then accepts only its own callers:
# devotee/astrologer routes from mobile-bff, operator routes from admin-bff, the sign-in claim from identity ONLY, the public astrologer list from either BFF.
ALLOWED_ISSUERS=mobile-bff,admin-bff,identity
# REQUIRED. The wallet service: every minute's debit and every refund. FAIL CLOSED: unreachable = 503 wallet_unavailable, never success.
WALLET_URL=http://127.0.0.1:4060
# REQUIRED. The identity service: a devotee's name, the device a push goes to, and the astrologer role written back to the user.
IDENTITY_URL=http://127.0.0.1:4040
# REQUIRED. The engagement service: the billing rules (minMinutes, ringTimeoutSec, defaultSharePct, payoutPaisePerCoin, callsEnabled) and push tokens.
# The money-affecting rules are read FRESH and FAIL CLOSED (503 settings_unavailable); the ring timeout falls back to its default.
ENGAGEMENT_URL=http://127.0.0.1:4030
# Timeout for a call to another service, ms.
SERVICE_TIMEOUT_MS=5000
# Timeout for a call to the WALLET, ms. A call that times out after it was sent is AMBIGUOUS: the minute stays due and is asked again with the SAME key.
WALLET_TIMEOUT_MS=5000
# Timeout for a balance that is only SHOWN in the call view the app polls (shorter, so a frozen wallet cannot hold every poll): after one failure it is skipped for 5 s.
WALLET_DISPLAY_TIMEOUT_MS=1500
# Where "incoming call" notifications are posted (Expo's push API).
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Derives the devotee pseudonyms ("Devotee ••4821") shown to roles that may not see devotees: use the SAME value as the admin BFF, the
# wallet, orders and the monolith. Unset (or shorter than 16 chars) = random per boot.
ADMIN_SESSION_SECRET=
# Real-time audio. agora | mock. Unset: agora when both Agora values are set, else mock outside production. The mock is REFUSED in
# production (a fake token would "connect" every call to nothing while still charging for it) and anything unusable answers 503 calls_unavailable.
RTC_PROVIDER=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# The billing clock (ms between passes, 0 = off), and how long a connected party may go unheard of before the call is ended.
TICK_EVERY_MS=5000
SILENCE_MS=90000
# The refund sweeper (ms between passes, 0 = off), how old a pending intent must be before it is looked at, and how long an intent the wallet
# has never heard of waits before it is closed `expired`.
SWEEP_EVERY_MS=5000
INTENT_MIN_AGE_MS=10000
INTENT_GRACE_MS=120000
# Terminal intents (done / failed / expired / refunded) are deleted after this many days; a pending intent never is. PRUNE_EVERY_MS 0 = off.
INTENT_RETENTION_DAYS=30
PRUNE_EVERY_MS=3600000
# production | (unset).
NODE_ENV=
# Reported by /health so a deploy can tell the new build from the old.
RENDER_GIT_COMMIT=
GIT_COMMIT=
