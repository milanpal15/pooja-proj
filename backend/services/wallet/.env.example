# Port this service listens on (internal network only; the BFFs are the public edge).
PORT=4060
# MongoDB server (base URI, no database name needed). The service always uses its OWN database, DB_NAME below.
# Local:  mongodb://127.0.0.1:27017        Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
# Database owned by this service (collections: wallets, wallettxns, coinpacks, coinorders).
DB_NAME=wallet
# HS256 secret shared by every service and BFF (>= 16 chars). Requests without a valid token are refused with 401.
INTERNAL_JWT_SECRET=
# Callers allowed to talk to this service (JWT `iss`), comma-separated. Each route family then accepts only its own callers:
# the devotee routes and the webhook come from the BFFs, the ledger API (debit/refund/txn/balance) from the monolith / orders / calls.
ALLOWED_ISSUERS=mobile-bff,admin-bff,monolith,pooja-api,orders,calls
# REQUIRED. The engagement service: the settings table (coin rate, the billing rules).
ENGAGEMENT_URL=http://127.0.0.1:4030
# REQUIRED. The identity service: names behind the admin wallet search and the `who` column. Down = the search is a clear 503
# and `who` falls back to the uid; no balance is ever affected.
IDENTITY_URL=http://127.0.0.1:4040
# Timeout for a call to another service, ms.
SERVICE_TIMEOUT_MS=5000
# Payments: razorpay | mock | (unset = razorpay when both keys are set, else mock - but NEVER mock in production).
# `mock` credits coins without any money moving; it is refused when NODE_ENV=production even if asked for by name.
PAYMENTS_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you set on Razorpay's webhook (Dashboard > Webhooks). The webhook URL must keep pointing at the mobile BFF
# (https://<mobile-bff>/api/webhooks/razorpay), never at this service. Unset = the webhook answers 503.
RAZORPAY_WEBHOOK_SECRET=
# Derives the devotee pseudonyms ("Devotee ••4821") shown to roles that may not see devotees: use the SAME value as the admin
# BFF and the monolith. Unset (or shorter than 16 chars) = random per boot, so the pseudonyms change on every restart.
ADMIN_SESSION_SECRET=
# How often the ledger reconciler finishes rows left `pending` by a crash, ms (0 = off).
RECONCILE_EVERY_MS=15000
# production | (unset). Production refuses PAYMENTS_PROVIDER=mock.
NODE_ENV=
# Reported by /health so a deploy can tell the new build from the old.
RENDER_GIT_COMMIT=
GIT_COMMIT=
