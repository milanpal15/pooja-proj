# Port this service listens on (internal network only; the BFFs are the public edge).
PORT=4040
# MongoDB server (base URI, no database name needed). The service always uses its OWN database, DB_NAME below.
# Local:  mongodb://127.0.0.1:27017        Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
# Database owned by this service (users, operators, auditlogs, policies).
DB_NAME=identity
# HS256 secret shared by every service and BFF (>= 16 chars). Requests without a valid token are refused with 401.
INTERNAL_JWT_SECRET=
# Callers allowed to talk to this service (JWT `iss`), comma-separated. Each route then narrows this further
# (devotee routes: mobile-bff only; operator routes: admin-bff only; directory: the services; push/send + push/reachable: calls, orders, engagement).
ALLOWED_ISSUERS=mobile-bff,admin-bff,monolith,catalog,wallet,orders,calls,engagement,events
# The calls service (phase 6) owns astrologers: identity asks it to claim an astrologer invite at sign-in and to say who is an active astrologer.
# UNSET = the monolith still owns them and is asked at MONOLITH_URL instead (rollback = unset this).
# CALLS_URL=http://127.0.0.1:4080
# The monolith: only asked about astrologers while CALLS_URL is unset.
MONOLITH_URL=http://127.0.0.1:4000
# Timeout for a call to the monolith, ms.
SERVICE_TIMEOUT_MS=5000
# The first dashboard admin, created ONLY while the operators collection is empty (changing the password later does nothing).
# Production refuses to start with no operator and no ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Firebase Admin, used for push notifications (Firebase Cloud Messaging with this same key; the FCM API (V1) must be enabled for the project) and for two things: revoking a blocked devotee's refresh tokens and deleting their Firebase
# account when the dashboard deletes them. (Token VERIFICATION happens in the mobile BFF.) Unset = those two are skipped
# with a warning; blocking still takes effect (the BFF refuses a blocked uid). Same lookup order as pooja-api:
#   FIREBASE_SERVICE_ACCOUNT (inline JSON) > FIREBASE_SERVICE_ACCOUNT_PATH (file) > GOOGLE_APPLICATION_CREDENTIALS (file)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=
# production | (unset)
NODE_ENV=
# Reported by /health so a deploy can tell the new build from the old.
RENDER_GIT_COMMIT=
GIT_COMMIT=
