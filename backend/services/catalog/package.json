{
  "name": "@bhakti/service-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Catalog service: content (deities, temples, aartis, festivals ...), Home layout, live darshan, pooja and chadhava definitions, panchang, horoscope and GridFS media.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 src/*.test.mjs src/modules/*/*.test.mjs"
  },
  "dependencies": {
    "@bhakti/common": "0.1.0",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "mongoose": "8.24.5",
    "multer": "1.4.5-lts.2",
    "sanitize-html": "2.17.5"
  },
  "engines": { "node": ">=20.19.4" }
}
