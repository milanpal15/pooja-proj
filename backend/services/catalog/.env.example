# Port this service listens on (internal network only; the BFFs are the public edge).
PORT=4050
# MongoDB server (base URI, no database name needed). The service always uses its OWN database, DB_NAME below.
# GridFS media (`media.files` / `media.chunks`) lives in this database too.
# Local:  mongodb://127.0.0.1:27017        Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
# Database owned by this service.
DB_NAME=catalog
# HS256 secret shared by every service and BFF (>= 16 chars). Requests without a valid token are refused with 401.
INTERNAL_JWT_SECRET=
# Callers allowed to talk to this service (JWT `iss`), comma-separated. `monolith` is the pooja-api (booking/order pricing snapshot).
ALLOWED_ISSUERS=mobile-bff,admin-bff,monolith,pooja-api,wallet,orders,calls,identity,events
# REQUIRED. The engagement service (the settings table: prasad fee, chadhava fee/minimum).
ENGAGEMENT_URL=http://127.0.0.1:4030
# The orders side, which answers GET /internal/orders/pooja-stats (booking counts, rating aggregates): the ORDERS SERVICE (e.g.
# http://127.0.0.1:4070), or the monolith while ORDERS_URL is unset there (same path, same shape). Cached 30 s; unset or unreachable = booking count 0 and no rating shown, never an error.
ORDERS_URL=
# Timeout for a call to another service, ms.
SERVICE_TIMEOUT_MS=5000
# Largest file the dashboard may upload, MB.
MAX_UPLOAD_MB=25
# Optional: a directory of files from before media moved into the database (kept served as a fallback). Normally empty.
UPLOAD_DIR=
# YouTube Data API key for the live-darshan probe; empty = YouTube streams read as "not verified".
YOUTUBE_API_KEY=
# The 60 s live-stream probe job: 1 (default) or 0/false/off.
LIVE_PROBE=1
# Nearby temples map (docs/TEMPLE_MAP.md). Public Overpass instances, comma-separated, tried in order (60 s breaker per instance).
OVERPASS_URLS=https://overpass.openstreetmap.fr/api/interpreter,https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
# How long a cached answer stays fresh, days; an expired one is still served (stale:true) when every instance is down, for PLACES_STALE_DAYS more.
PLACES_CACHE_DAYS=7
PLACES_STALE_DAYS=30
# Sent on every upstream call. Overpass operators ask for an identifying User-Agent; add a contact if you have one.
PLACES_USER_AGENT=BhaktiApp/1.0 (temples map)
# Per upstream call / for all instances of one request, ms.
PLACES_TIMEOUT_MS=20000
PLACES_TOTAL_MS=25000
# How long a failing instance (429 / 5xx / timeout) is skipped, ms.
PLACES_BREAKER_MS=60000
# Upstream calls per second across the whole service, and requests per client per minute.
PLACES_UPSTREAM_PER_SEC=2
PLACES_RATE_PER_MIN=30
# production | (unset)
NODE_ENV=
# Reported by /health so a deploy can tell the new build from the old.
RENDER_GIT_COMMIT=
GIT_COMMIT=
