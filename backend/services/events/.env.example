# Port this service listens on (internal network only; the BFFs are the public edge).
PORT=4090
# MongoDB server (base URI, no database name needed). The service always uses its OWN database, DB_NAME below.
# Local:  mongodb://127.0.0.1:27017        Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
# Database owned by this service.
DB_NAME=events
# HS256 secret shared by every service and BFF (>= 16 chars). Requests without a valid token are refused with 401.
INTERNAL_JWT_SECRET=
# Callers allowed to talk to this service (JWT `iss`), comma-separated.
ALLOWED_ISSUERS=mobile-bff,admin-bff,catalog,orders,identity,wallet
# The catalog service: a stream / chadhava listing / pooja / temple / aarti an event refers to must exist there. Unset or unreachable =
# publishing an event is refused with 503 catalog_unavailable (drafts still save, with the references unchecked).
CATALOG_URL=
# The wallet service: event rewards (milestone / event coins) are credited here (type bonus, keys `event-...`; the wallet allows this
# caller nothing else and must list `events` in ITS ALLOWED_ISSUERS). Unset or down = a completion still counts, the coins stay pending and
# the sweeper (SWEEP_EVERY_MS) pays them, with the same idempotency key, once the wallet answers.
WALLET_URL=
# The identity service: real names / phones in the operator participants list, asked only for a role that may see devotees. Unset = pseudonyms
# (`Devotee ••4821`) for everyone. Identity must list `events` in ITS ALLOWED_ISSUERS.
IDENTITY_URL=
# Derives the devotee pseudonyms - use the SAME value as the admin BFF and the other services. Unset = random per boot (a warning is logged).
ADMIN_SESSION_SECRET=
# How often the reward sweeper retries unconfirmed coin credits and unfinished badge grants, milliseconds (0 = off).
SWEEP_EVERY_MS=15000
# Per-call timeout for the catalog / wallet / identity calls, milliseconds.
SERVICE_TIMEOUT_MS=5000
# production | (unset)
NODE_ENV=
# Reported by /health so a deploy can tell the new build from the old.
RENDER_GIT_COMMIT=
GIT_COMMIT=
