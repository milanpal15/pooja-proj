# Port this service listens on (internal network only; the BFFs are the public edge).
PORT=4070
# MongoDB server (base URI, no database name needed). The service always uses its OWN database, DB_NAME below.
# Local:  mongodb://127.0.0.1:27017        Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
# Database owned by this service (collections: bookings, chadhavaorders, poojareviews, orderintents).
# Run `node tools/split-db.mjs --service orders` BEFORE its first start on real data.
DB_NAME=orders
# HS256 secret shared by every service and BFF (>= 16 chars). Requests without a valid token are refused with 401.
INTERNAL_JWT_SECRET=
# Callers allowed to talk to this service (JWT `iss`), comma-separated. Each route family then accepts only its own callers:
# the devotee routes from mobile-bff, the operator routes from admin-bff, GET /pooja-stats from catalog only.
ALLOWED_ISSUERS=mobile-bff,admin-bff,catalog
# REQUIRED. The wallet service: every debit and refund. FAIL CLOSED: unreachable = 503 wallet_unavailable, never success.
WALLET_URL=http://127.0.0.1:4060
# REQUIRED. The catalog service: the priced snapshot a booking / chadhava order is made from, read fresh for every purchase.
# Unreachable = 503 catalog_unavailable BEFORE any coin moves.
CATALOG_URL=http://127.0.0.1:4050
# REQUIRED. The identity service: the first name a review is published under, `who` in the admin lists, the device a push goes to.
IDENTITY_URL=http://127.0.0.1:4040
# REQUIRED. The engagement service: the push token of that device ("your booking moved on" notifications, best effort).
ENGAGEMENT_URL=http://127.0.0.1:4030
# Timeout for a call to another service, ms.
SERVICE_TIMEOUT_MS=5000
# Timeout for a call to the WALLET, ms. A call that times out after it was sent is AMBIGUOUS: the intent stays pending and the sweeper settles it.
WALLET_TIMEOUT_MS=5000
# Where "booking moved on" notifications are posted (Expo's push API).
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Derives the devotee pseudonyms ("Devotee ••4821") shown to roles that may not see devotees: use the SAME value as the admin BFF, the
# wallet and the monolith. Unset (or shorter than 16 chars) = random per boot, so the pseudonyms change on every restart.
ADMIN_SESSION_SECRET=
# The saga sweeper (ms between passes, 0 = off), how old a pending intent must be before it is looked at, and how long an intent the wallet
# has never heard of waits before it is closed `expired`.
SWEEP_EVERY_MS=5000
INTENT_MIN_AGE_MS=10000
INTENT_GRACE_MS=120000
# Terminal intents (done / failed / expired / refunded) are deleted after this many days; a pending intent never is. PRUNE_EVERY_MS 0 = off.
INTENT_RETENTION_DAYS=30
PRUNE_EVERY_MS=3600000
# production | (unset).
NODE_ENV=
# Reported by /health so a deploy can tell the new build from the old.
RENDER_GIT_COMMIT=
GIT_COMMIT=
