# Port this BFF listens on.
PORT=4010
# The existing monolith (pooja-api) this gateway fronts. Every *_URL below may be a full URL or a bare host[:port]
# (what Render's fromService delivers): http:// is added for localhost / IPs / dotless private names, https:// otherwise.
MONOLITH_URL=http://127.0.0.1:4000
# Allowed browser origin(s), comma-separated. NEVER '*' in production (credentials are refused).
CORS_ORIGIN=*
# Phase 1: the engagement service (flags, announcements, analytics ingest). UNSET = a pure gateway to the monolith.
# When set, INTERNAL_JWT_SECRET (>= 16 chars, the same value on every service and the monolith) is required.
ENGAGEMENT_URL=
INTERNAL_JWT_SECRET=
# Phase 2: the identity service. SET = this BFF authenticates users itself (see below) and the monolith trusts its signed token.
# UNSET = the phase-1 behaviour (the monolith authenticates). Needs INTERNAL_JWT_SECRET too.
IDENTITY_URL=
# Phase 3: the catalog service (content, Home, live darshan, poojas, chadhava listings, panchang, horoscope, media). SET = `GET /api/content` is
# assembled HERE (catalog bundle + engagement settings/announcement; the last good body is served with x-degraded for up to 60 min when
# catalog is down) and /uploads is streamed from catalog (503 catalog_unavailable when it is down). Requires ENGAGEMENT_URL and IDENTITY_URL (Jai needs the devotee authenticated here).
# UNSET = the monolith serves all of it, as before.
CATALOG_URL=
# Phase 4: the wallet service (coin balances and ledger, coin packs, buying coins, the Razorpay webhook). SET = the wallet routes are served from it and
# the monolith retires them (404): `POST /api/webhooks/razorpay` is streamed byte for byte (keep Razorpay's webhook URL pointing at THIS BFF, never at the
# wallet service), a wallet that is down answers 503 wallet_unavailable. Needs INTERNAL_JWT_SECRET; on the mobile BFF also IDENTITY_URL.
# UNSET = the monolith serves all of it, as before.
WALLET_URL=
# Orders service (phase 5): pooja bookings, chadhava orders and reviews. SET = the devotee booking / chadhava-order routes, the retired POST /api/chadhava (410) and the public review list are served from the orders service
# and the monolith retires them (404); orders unreachable answers 503 orders_unavailable. Needs INTERNAL_JWT_SECRET; on the mobile BFF also IDENTITY_URL (the devotee routes need its device auth edge).
# UNSET = the monolith serves all of it, as before.
ORDERS_URL=
# The events service (docs/EVENTS.md). `GET /api/events[/:slug]` (published events, no sign-in needed) are served from it; unreachable = 503 events_unavailable. Needs INTERNAL_JWT_SECRET. Unset = those paths are not served.
EVENTS_URL=
# How long a purchase (booking / chadhava order / cancel) may take through orders, ms. Orders calls catalog and the wallet (5 s each) inside it.
ORDERS_TIMEOUT_MS=15000
# Firebase ID token verification (mobile BFF only; the admin BFF never holds a Firebase key). The project id alone is enough; it must be the
# SAME project as poojaappclone/google-services.json. A service-account key is also accepted (same lookup order as pooja-api).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=
# Timeout for a call to a service, ms (the shared client also retries an idempotent GET once and has a circuit breaker).
SERVICE_TIMEOUT_MS=5000
# Idle timeout for a proxied upstream request, ms.
PROXY_TIMEOUT_MS=30000
# production | (unset). Enables trust proxy and the CORS credential rule.
NODE_ENV=
# Reported by /api/health so CI can tell a finished deploy.
RENDER_GIT_COMMIT=
GIT_COMMIT=

