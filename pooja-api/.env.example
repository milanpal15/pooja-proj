# pooja-api — the backend. Copy to .env and adjust.
#
# Every variable the server reads is listed here, commented where it has a
# working default. The .env file itself is gitignored; this one is not, so
# never put a real secret in it.

# ───────────────────────────────────────────────────────────── basics ──
PORT=4000
# production makes the server REFUSE TO START with no operators and no
# ADMIN_PASSWORD, rather than booting an open admin API.
NODE_ENV=development

# ──────────────────────────────────────────────────────────── database ──
# Must name a database of its OWN. Pointing this at a database another app
# uses will collide on `users`, `settings` and `events`.
# Local:  mongodb://127.0.0.1:27017/bhakti
# Atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/bhakti?retryWrites=true&w=majority
#
# Uploaded media lives in here too (GridFS), so this is the only thing that
# needs backing up — and the only thing with a storage limit. Atlas M0 is
# 512MB for documents and media together.
MONGODB_URI=mongodb://127.0.0.1:27017/bhakti

# ─────────────────────────────────────────────────────────────── CORS ──
# Comma-separated origins allowed to call the API.
#
# `*` is fine locally and WRONG in production: the admin session is a
# cookie, and a browser refuses a wildcard origin on a credentialed
# request, so every dashboard call would fail. Set it to the dashboard's
# exact URL. A bare host is accepted and assumed https.
CORS_ORIGIN=*

# true = ANY other origin may also call the API, but WITHOUT credentials (no cookie): public reads
# work from anywhere. Only the origins listed in CORS_ORIGIN keep credentials, which is what the
# dashboard needs. Never grants credentials to an unlisted origin — that would let any website an
# operator visits act as them (SESSION_SAMESITE=None sends the cookie cross-site).
CORS_ALLOW_ANY=false

# Strict | Lax | None. Dev keeps Strict because Vite proxies /api, so the
# dashboard and API share an origin. Deployed they do not, and Strict means
# the browser never sends the cookie — sign-in appears to work and every
# call after it 401s. None requires HTTPS.
SESSION_SAMESITE=Strict

# ─────────────────────────────────────────────────────────── Firebase ──
# Verifies the ID tokens the phone app sends. Firebase console → Project
# settings → Service accounts → Generate new private key. ONE of these two
# (the path is easiest locally, the inline JSON is for hosted deploys):
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
#
# Without it the server still runs, but /api/auth/* answers 503 and nobody
# can sign in. It must be from the SAME Firebase project as the app's
# google-services.json, or every token is rejected on `aud`.

# ────────────────────────────────────────────────────────────── admin ──
# Bootstraps the FIRST operator on an empty operator collection, and does
# nothing after that — later password changes happen in the Operators tab.
# Left empty locally the dashboard is open, with a warning on boot.
ADMIN_PASSWORD=
# Signs the session cookie. Set it to keep people signed in across a
# restart, or to share sessions between instances. Generated if empty.
ADMIN_SESSION_SECRET=

# ───────────────────────────────────────────────────────────── uploads ──
# Biggest single upload the dashboard may send. Uploads are buffered in
# memory on the way to the database, so this is a memory ceiling too.
MAX_UPLOAD_MB=25
# Only for media written BEFORE it moved into MongoDB — that directory is
# still served so old rows keep resolving. Nothing is written here now, so
# a hosted deploy does not need a disk. See `npm run migrate:media`.
# UPLOAD_DIR=./uploads

# ───────────────────────────────────────────────── scripts, not the server ──
# Read only by scripts/, never by the running API:
#   BASE            scripts/smoke.mjs — which server to test (default :4000)
#   ADMIN_USERNAME  scripts/smoke.mjs — operator to sign in as (default admin)
# RENDER_GIT_COMMIT is set by Render itself and reported by /api/health.

# ────────────────────────────────────────────────────────── payments ──
# How devotees buy coins. razorpay | mock. Unset: razorpay when both keys
# below are set, otherwise mock — but never mock in production, where
# `mock` is refused (it would hand out free coins) and, with no keys, the
# order endpoints answer 503 payments_unavailable.
PAYMENTS_PROVIDER=
# From the Razorpay dashboard (Settings → API keys). Use rzp_test_… keys
# until you go live. The key SECRET stays on the server; the id is sent to
# the app so it can open checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when adding the webhook in Razorpay (Settings →
# Webhooks → URL: https://<api>/api/webhooks/razorpay, events payment.captured
# and order.paid). It is what credits coins if the app never reported back.
RAZORPAY_WEBHOOK_SECRET=

# ───────────────────────────────────────────────── astrologer calls (audio) ──
# Which real-time audio provider carries a call. agora | mock. Unset: agora
# when both Agora values below are set, otherwise mock — but never mock in
# production, where `mock` is refused (calls would "connect" to nothing yet
# still be charged) and POST /api/calls answers 503 calls_unavailable.
# With CALLS_URL set (below) the calls service reads these three (backend/services/calls/.env) and this process does not.
RTC_PROVIDER=
# From console.agora.io → your project. The certificate is a SECRET: it signs
# the short-lived tokens handed to the two people on a call. The app id is
# sent to the app along with each token.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ──────────────────────────────────────────────────────────── live darshan ──
# YouTube Data API v3 key (Google Cloud → APIs → YouTube Data API v3). It lets the
# 60 s probe check whether a YouTube stream is really broadcasting and read the
# viewer count. Unset: YouTube streams show as live on the operator's switch only,
# flagged unverified — the page is never scraped. A secret: keep it out of the repo.
YOUTUBE_API_KEY=

# ───────────────────────────────────────── microservices migration ──
# docs/MICROSERVICES.md, phase 1. UNSET (default) = this server owns flags, settings, announcements and analytics
# in its own collections, exactly as always. SET = those live in the engagement service at this URL: this server
# reads settings/announcements through it (5 s timeout, 15 s cache, falls back to defaults when it is down) and
# stops serving the migrated routes (the BFFs do). Rollback = unset it.
ENGAGEMENT_URL=
# Phase 2 (identity). UNSET (default) = this server owns users, operators, policies and the audit log and verifies Firebase
# ID tokens / the operator cookie itself. SET = those live in the identity service at this URL: the BFFs authenticate
# (mobile-bff verifies the Firebase token, admin-bff owns the session cookie) and this server TRUSTS their signed service
# token (INTERNAL_JWT_SECRET below; devotee routes only from mobile-bff, operator routes only from admin-bff), reads user
# names / device ids through the identity service (5 s timeout, 15 s cache, degrades to "absent"), and stops serving
# /api/auth, /api/users, /api/admin/operators|audit-log|policies|login|logout|session. Rollback = unset it.
# Keep ADMIN_SESSION_SECRET the SAME here and on the admin BFF: the BFF signs the cookie with it, this server derives the
# devotee pseudonyms ("Devotee ••4821") from it.
IDENTITY_URL=
# Phase 3 (catalog). UNSET (default) = this server owns content, Home, live darshan, pooja/chadhava definitions, panchang,
# horoscope and uploaded media. SET = those live in the catalog service at this URL (the BFFs serve their routes, and
# assemble GET /api/content): this server stops serving and seeding them (404), PRICES every booking and chadhava order
# from the catalog's authoritative snapshot (read fresh per purchase; catalog down = 503 catalog_unavailable, never a stale
# price) and answers the catalog's GET /internal/orders/pooja-stats. Needs ENGAGEMENT_URL on the catalog (not here).
# Rollback = unset it (the catalog's data is not copied back; the old collections here are untouched).
CATALOG_URL=
# Phase 4 (wallet). UNSET (default) = this server owns wallets, the coin ledger, coin packs and purchases and talks to Razorpay
# itself. SET = those live in the wallet service at this URL (the BFFs serve /api/wallet*, /api/coins/packs, the Razorpay webhook
# and the dashboard's coin/wallet/billing-rule routes): this server stops serving and seeding them (404), moves coins ONLY through
# the wallet service (5 s timeout, FAIL CLOSED: unreachable = 503 wallet_unavailable, never success; every call keeps its
# idempotency key; a purchase whose answer was lost is finished by a sweeper from a durable note written before the money moved),
# and NO LONGER READS PAYMENTS_PROVIDER / RAZORPAY_* above (set them on the wallet service instead). Requires ENGAGEMENT_URL
# (the billing rules the wallet writes live there) - the server refuses to start with WALLET_URL alone. Rollback = unset it.
WALLET_URL=
# Orders service (phase 5 of docs/MICROSERVICES.md), e.g. http://127.0.0.1:4070. UNSET (the default) = this server owns pooja bookings, chadhava
# orders and pooja reviews (and the money saga around them), exactly as before. SET = the orders service does: this server answers 404 for
# /api/bookings*, /api/chadhava/orders*, POST /api/chadhava, /api/poojas/:slug/reviews and /api/admin/bookings|reviews|chadhava-orders, stops
# serving GET /internal/orders/pooja-stats (the orders service answers it) and leaves booking/chadhava saga intents to the orders service.
# Requires CATALOG_URL, WALLET_URL, IDENTITY_URL and ENGAGEMENT_URL (the server refuses to start otherwise). Rollback = unset it.
ORDERS_URL=
# Phase 6 (docs/MICROSERVICES.md). Unset = this process owns astrologers, calls (with their per-minute billing ticker and the audio provider above) and
# payouts, as ever, and answers identity's /internal/astrologers/claim|active. Set to the calls service's URL = those live there: this process answers 404 for
# /api/astrologers*, /api/astrologer/me/*, /api/calls*, /api/admin/astrologers|calls|payouts, retires the internal claim endpoints, stops its billing ticker
# and stops seeding them. Requires WALLET_URL, IDENTITY_URL and ENGAGEMENT_URL (the server refuses to start otherwise). Rollback = unset it.
CALLS_URL=
# HS256 secret shared with the services and BFFs (>= 16 chars). Signs calls to engagement / identity / catalog / wallet, verifies the
# BFFs' tokens and the admin BFF's POST /internal/audit. Required when ENGAGEMENT_URL, IDENTITY_URL, CATALOG_URL, WALLET_URL, ORDERS_URL or CALLS_URL is set.
INTERNAL_JWT_SECRET=
