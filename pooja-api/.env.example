# pooja-api — the backend. Copy to .env and adjust.
#
# Every variable the server reads is listed here, commented where it has a
# working default. The .env file itself is gitignored; this one is not, so
# never put a real secret in it.

# ───────────────────────────────────────────────────────────── basics ──
PORT=4000
# production makes the server REFUSE TO START with no operators and no
# ADMIN_PASSWORD, rather than booting an open admin API.
NODE_ENV=development

# ──────────────────────────────────────────────────────────── database ──
# Must name a database of its OWN. Pointing this at a database another app
# uses will collide on `users`, `settings` and `events`.
# Local:  mongodb://127.0.0.1:27017/bhakti
# Atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/bhakti?retryWrites=true&w=majority
#
# Uploaded media lives in here too (GridFS), so this is the only thing that
# needs backing up — and the only thing with a storage limit. Atlas M0 is
# 512MB for documents and media together.
MONGODB_URI=mongodb://127.0.0.1:27017/bhakti

# ─────────────────────────────────────────────────────────────── CORS ──
# Comma-separated origins allowed to call the API.
#
# `*` is fine locally and WRONG in production: the admin session is a
# cookie, and a browser refuses a wildcard origin on a credentialed
# request, so every dashboard call would fail. Set it to the dashboard's
# exact URL. A bare host is accepted and assumed https.
CORS_ORIGIN=*

# Strict | Lax | None. Dev keeps Strict because Vite proxies /api, so the
# dashboard and API share an origin. Deployed they do not, and Strict means
# the browser never sends the cookie — sign-in appears to work and every
# call after it 401s. None requires HTTPS.
SESSION_SAMESITE=Strict

# ─────────────────────────────────────────────────────────── Firebase ──
# Verifies the ID tokens the phone app sends. Firebase console → Project
# settings → Service accounts → Generate new private key. ONE of these two
# (the path is easiest locally, the inline JSON is for hosted deploys):
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
#
# Without it the server still runs, but /api/auth/* answers 503 and nobody
# can sign in. It must be from the SAME Firebase project as the app's
# google-services.json, or every token is rejected on `aud`.

# ────────────────────────────────────────────────────────────── admin ──
# Bootstraps the FIRST operator on an empty operator collection, and does
# nothing after that — later password changes happen in the Operators tab.
# Left empty locally the dashboard is open, with a warning on boot.
ADMIN_PASSWORD=
# Signs the session cookie. Set it to keep people signed in across a
# restart, or to share sessions between instances. Generated if empty.
ADMIN_SESSION_SECRET=

# ───────────────────────────────────────────────────────────── uploads ──
# Biggest single upload the dashboard may send. Uploads are buffered in
# memory on the way to the database, so this is a memory ceiling too.
MAX_UPLOAD_MB=25
# Only for media written BEFORE it moved into MongoDB — that directory is
# still served so old rows keep resolving. Nothing is written here now, so
# a hosted deploy does not need a disk. See `npm run migrate:media`.
# UPLOAD_DIR=./uploads

# ───────────────────────────────────────────────── scripts, not the server ──
# Read only by scripts/, never by the running API:
#   BASE            scripts/smoke.mjs — which server to test (default :4000)
#   ADMIN_USERNAME  scripts/smoke.mjs — operator to sign in as (default admin)
#   DAYS            scripts/seed-demo.mjs — how many days to seed
# RENDER_GIT_COMMIT is set by Render itself and reported by /api/health.
