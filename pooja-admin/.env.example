# pooja-admin — the dashboard. Copy to .env and adjust.
#
# The dashboard is a static site. It has no database and no secrets: the
# only thing it needs to know is where the API is. Anything put here ends
# up readable in the built bundle, so nothing secret belongs in it.
#
# This file used to carry MONGODB_URI, CORS_ORIGIN and a Firebase key path
# — left over from when the API lived in this folder. It does not any more;
# those belong in pooja-api/.env.

# ─────────────────────────────────────────────────────── dev (npm run dev) ──
# Vite proxies /api and /uploads to this origin, so the browser still sees
# ONE origin and there is no CORS and no cookie problem. This is the knob
# to change when you want the local dashboard to drive a different API.
#
#   http://localhost:4000            a local pooja-api  (default)
#   https://pooja-api.onrender.com   the deployed one
API_ORIGIN=http://localhost:4000

# ────────────────────────────────────────────────── build (npm run build) ──
# Baked into the bundle at BUILD time, so changing it is a rebuild, not a
# restart. Leave it EMPTY for dev — empty means same-origin, which is what
# the proxy above gives you.
#
# Only needed when the built site is hosted somewhere that cannot proxy.
# On Render the blueprint fills it in from the API service, so you do not
# set it by hand there.
VITE_API_BASE=
