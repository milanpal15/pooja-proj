# Copy to .env and adjust.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pooja_admin
# Comma-separated origins allowed to call the API (admin web app). * for any.
CORS_ORIGIN=*

# ---------------------------------------------------------------- Firebase --
# Needed to verify the ID tokens the mobile app sends. Get the JSON from
# Firebase console → Project settings → Service accounts → Generate new
# private key. Provide it ONE of these two ways (path is easiest locally):
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# ...or inline, as a single-line JSON string (handy for hosted deploys):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
#
# Without this the server still runs, but /api/auth/* answers 503 and nobody
# can sign in. Never commit the key file.
