{
  "name": "pooja-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Admin dashboard for the Divine Temple Portal — Express API and React UI in one app.",
  "main": "src/server/index.js",
  "scripts": {
    "dev": "concurrently -n api,ui -c magenta,cyan \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "node --watch src/server/index.js",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "npm run build && node src/server/index.js",
    "serve": "node src/server/index.js",
    "seed": "node src/server/seed.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^13.10.0",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "vite": "^5.4.0"
  }
}
