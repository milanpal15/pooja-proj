# Bhakti (the phone app) — copy to .env and adjust.
#
# EXPO_PUBLIC_* values are embedded in the JS bundle, so none of them is a
# secret and none can be. They are also read at BUNDLE time: changing one
# needs Metro restarted, not just the app reloaded.

# ──────────────────────────────────────────────────────────── backend ──
# Where the app looks for the API.
#
#   https://pooja-api.onrender.com   the deployed API
#   http://127.0.0.1:4000            a local one, which also needs
#                                    `adb reverse tcp:4000 tcp:4000`
#
# Commented out entirely, the app falls back to http://127.0.0.1:4000.
EXPO_PUBLIC_ADMIN_API=https://pooja-api.onrender.com

# ───────────────────────────────────────────────────────── Google auth ──
# The WEB OAuth client id (client_type 3) from google-services.json — NOT
# the Android one. Google Sign-In needs it to mint an ID token Firebase
# will accept, and the debug SHA-1 must be registered in Firebase too.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ──────────────────────────────────────────────────────────── support ──
# Shown on Help & Support. The dashboard's Settings tab overrides these.
# Leave them unset and the Call / Email buttons are hidden rather than
# offering a contact nobody answers.
# EXPO_PUBLIC_SUPPORT_EMAIL=support@yourtemple.org
# EXPO_PUBLIC_SUPPORT_PHONE=+911800123456
# EXPO_PUBLIC_SUPPORT_HOURS_EN=6 AM – 10 PM IST
# EXPO_PUBLIC_SUPPORT_HOURS_HI=सुबह 6 से रात 10 बजे तक

# ─────────────────────────────────────────────────────────── store link ──
# The app's Play Store / App Store URL. Appended to the "Share the app" text
# and enables "Rate the app" on Profile. Unset (the default) means the share
# text goes out alone and the Rate row is hidden — no invented link.
# EXPO_PUBLIC_STORE_URL=https://play.google.com/store/apps/details?id=com.poojaapp.poojaapp
